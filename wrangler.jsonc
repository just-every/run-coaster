{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expenses-coaster",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COASTER_RECEIPTS",
      "bucket_name": "coaster-receipts"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "",
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": "",
    "QBO_ENVIRONMENT": "sandbox",
    "AI_ENABLED": "false",
    "AI_MODEL": "gpt-6.1-sol",
    "AI_BASE_URL": "https://api.openai.com/v1"
  }
}
