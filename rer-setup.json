{
  "schema": 1,
  "title": "Foundation",
  "groups": [
    {
      "id": "application",
      "label": "Your application"
    },
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "accounting",
      "label": "Optional accounting choices"
    },
    {
      "id": "receipt-reading",
      "label": "Optional receipt reading"
    },
    {
      "id": "mail",
      "label": "Hosted mail"
    }
  ],
  "fields": [
    {
      "name": "APP_NAME",
      "label": "Application name",
      "help": "The name shown in your new application.",
      "kind": "text",
      "required": true,
      "default": "Foundation",
      "group": "application"
    },
    {
      "name": "PRIMARY_COLOR",
      "label": "Brand colour",
      "kind": "colour",
      "required": true,
      "default": "#1E9E3A",
      "group": "application"
    },
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "Sign-in links for this address appear in the local development outbox; no email is sent.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "INSTALLATION_KEY",
      "label": "Installation encryption key",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": true,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "help": "Optional Auth install. Leave empty to use email links.",
      "default": ""
    },
    {
      "name": "QBO_CLIENT_ID",
      "label": "QuickBooks app client ID",
      "kind": "secret",
      "required": false,
      "group": "accounting",
      "help": "Optional Intuit app credentials. The company still requires explicit consent in Settings; blank leaves QuickBooks disconnected.",
      "ownerVisible": true,
      "input": "entered"
    },
    {
      "name": "QBO_CLIENT_SECRET",
      "label": "QuickBooks app client secret",
      "kind": "secret",
      "required": false,
      "group": "accounting",
      "ownerVisible": true,
      "input": "entered"
    },
    {
      "name": "QBO_ENVIRONMENT",
      "label": "QuickBooks environment",
      "kind": "text",
      "required": false,
      "default": "sandbox",
      "group": "accounting",
      "help": "sandbox or production. This selects the company API; it never authorizes a company by itself."
    },
    {
      "name": "AI_ENABLED",
      "label": "AI transport enabled",
      "kind": "text",
      "required": false,
      "default": "false",
      "group": "receipt-reading",
      "help": "true or false. Native receipt reading also requires an owner or admin to enable it and an employee to consent to each original."
    },
    {
      "name": "AI_MODEL",
      "label": "Vision model",
      "kind": "text",
      "required": false,
      "default": "gpt-6.1-sol",
      "group": "receipt-reading"
    },
    {
      "name": "AI_API_KEY",
      "label": "AI provider API key",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "receipt-reading",
      "help": "Optional direct AI transport credential. Receipt originals leave this installation only after explicit consent."
    },
    {
      "name": "AI_BASE_URL",
      "label": "AI provider URL",
      "kind": "url",
      "required": false,
      "default": "https://api.openai.com/v1",
      "group": "receipt-reading",
      "help": "HTTPS API supporting image input and structured Responses. No automatic provider fallback."
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Mail provider",
      "kind": "select",
      "required": true,
      "default": "rer",
      "options": [
        {
          "value": "rer",
          "label": "RER managed mail"
        },
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "cloudflare",
          "label": "Cloudflare Email Sending"
        },
        {
          "value": "development",
          "label": "Local development outbox"
        }
      ],
      "group": "mail",
      "help": "Local setup uses its outbox. Hosted installations require RER managed mail or a configured direct provider."
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender address",
      "kind": "text",
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "mail"
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "ownerVisible": true,
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_ACCOUNT_ID",
      "label": "Cloudflare account ID",
      "kind": "text",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "cloudflare"
      },
      "group": "mail"
    }
  ],
  "steps": [
    {
      "type": "extension",
      "id": "branding"
    },
    {
      "type": "owner-claim",
      "mode": "setup-token",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ],
  "business": {
    "settings": 1,
    "values": [
      "display_name"
    ],
    "team": {
      "roles": {
        "admin": "admin",
        "member": "member"
      }
    }
  }
}
