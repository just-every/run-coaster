{
  "schema": 1,
  "title": "Foundation",
  "groups": [
    {
      "id": "application",
      "label": "Your application"
    },
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "accounting",
      "label": "Optional accounting choices"
    }
  ],
  "fields": [
    {
      "name": "APP_NAME",
      "label": "Application name",
      "help": "The name shown in your new application.",
      "kind": "text",
      "required": true,
      "default": "Foundation",
      "group": "application"
    },
    {
      "name": "PRIMARY_COLOR",
      "label": "Brand colour",
      "kind": "colour",
      "required": true,
      "default": "#1E9E3A",
      "group": "application"
    },
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "Sign-in links for this address appear in the local development outbox; no email is sent.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": true,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "help": "Optional Auth install. Leave empty to use email links.",
      "default": ""
    },
    {
      "name": "QBO_CLIENT_ID",
      "label": "QuickBooks app client ID",
      "kind": "secret",
      "required": false,
      "group": "accounting",
      "help": "Optional Intuit app credentials. The company still requires explicit consent in Settings; blank leaves QuickBooks disconnected.",
      "ownerVisible": true
    },
    {
      "name": "QBO_CLIENT_SECRET",
      "label": "QuickBooks app client secret",
      "kind": "secret",
      "required": false,
      "group": "accounting",
      "ownerVisible": false
    },
    {
      "name": "QBO_ENVIRONMENT",
      "label": "QuickBooks environment",
      "kind": "text",
      "required": false,
      "default": "sandbox",
      "group": "accounting",
      "help": "sandbox or production. This selects the company API; it never authorizes a company by itself."
    }
  ],
  "steps": [
    {
      "type": "extension",
      "id": "branding"
    },
    {
      "type": "owner-claim",
      "mode": "setup-token",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ]
}
