{
  "name": "@expenses/coaster",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "test:typecheck": "rer queue test:typecheck -- sh -c \"node --test tests/incremental-typecheck.test.mjs\"",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:runtime": "rer queue test:runtime -- sh -c \"node tests/runtime.mjs\"",
    "test:email-link": "rer queue test:email-link -- sh -c \"node tests/email-link.mjs\"",
    "onboard": "node scripts/install.mjs",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "build:site": "rer build --site",
    "verify:app": "rer queue verify:app -- sh -c \"pnpm run build && pnpm run build:site && pnpm run test:site && pnpm run typecheck && pnpm run test:typecheck && pnpm run test:coaster && pnpm run test:runtime && pnpm run test:email-link\"",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "outbox": "rer outbox",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:coaster": "node tests/coaster-suite.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:site": "node --test tests/site/*.test.mjs",
    "delivery:spec": "node scripts/build-deployment-spec.mjs",
    "check:deployment-spec": "node scripts/build-deployment-spec.mjs --check"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@stacksjs/ts-webp": "0.1.6",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@workeryard/undershell": "0.1.1",
    "fast-png": "8.0.0",
    "hono": "4.13.7",
    "jpeg-js": "0.4.4",
    "libheif-js": "1.17.1",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.79",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.14.0",
    "esbuild": "0.28.1",
    "marked": "18.0.14",
    "miniflare": "5.20260907.0-alpha",
    "ssh2": "1.17.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1",
    "ws": "8.21.0"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
